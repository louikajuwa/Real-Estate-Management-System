APP_NAME="Real Estate Management"
APP_ENV=local
APP_KEY=
# Set APP_ENV=production and APP_DEBUG=false outside local development.
APP_DEBUG=true
APP_URL=http://localhost:8100

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=realestate
DB_USERNAME=realestate
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=public

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# Run database seeders (demo data, default passwords) on container start. Local dev only.
SEED_ON_BOOT=true

ADMIN_NAME="Admin User"
ADMIN_EMAIL=admin@realestate.com
ADMIN_PASSWORD=password

SOCKET_URL=http://localhost:6001
SOCKET_CORS_ORIGIN=http://localhost:8100
